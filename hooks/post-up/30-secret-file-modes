#!/usr/bin/env bash
#
# rcm post-up hook: keep tool config files that hold API keys readable by the
# owner only (mode 600).
#
# Some CLIs write their keys into plain JSON with the default umask, which
# leaves them readable by every local user. This hook tightens the modes after
# every rcup. It never creates, reads or edits the files. Missing paths are
# skipped, so the hook is a no-op on machines without these tools.

set -uo pipefail

shopt -s nullglob
files=(
  "$HOME"/.ccs/*.settings.json
  "$HOME"/.ccs/config.json
)

for f in "${files[@]}"; do
  [[ -f "$f" && ! -L "$f" ]] || continue
  if [[ "$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f")" != "600" ]]; then
    chmod 600 "$f" && echo "[modes] $f set to 600"
  fi
done

[[ -d "$HOME/.ccs" ]] && chmod 700 "$HOME/.ccs"
exit 0
