# Brewfile.devops - DevOps and Infrastructure tools (workstation only)
# Tailscale is NOT here - the cask in Brewfile.apps covers every machine
# (formula + cask together would run two daemons).
# Usage: brew bundle --file=Brewfile.devops

# AWS
brew "awscli"
cask "aws-vault-binary"         # AWS credentials manager (renamed upstream)

# Terraform
brew "terraform-docs"           # Terraform documentation generator
brew "terragrunt"               # Terraform workflow tool
#
# terraform, tflint and packer are NOT here. HashiCorp's BUSL relicensing got
# them removed from homebrew-core, and brew only ever gave us one version at a
# time anyway - which is the wrong shape for consulting, where different
# clients pin different versions.
#
# They are managed by mise instead (see scripts/setup-mise-tools.sh), which
# already replaces asdf/nvm/pyenv here and can pin per-project versions from a
# repo's own mise.toml. tfswitch went the same way.

# Configuration Management
brew "ansible"

# Secrets
brew "sops"                     # Secrets management - Encrypt / decrypt files
