# Brewfile.ai.personal - AI tools for every non-work machine
#
# Ownership tier: installed unless the machine is --work. A client laptop gets
# only Brewfile.ai, because agents whose model providers a client has not
# approved (qwen-code, kimi-code) should not be one keystroke away from client
# code there.
#
# Usage: brew bundle --file=Brewfile.ai.personal

# CLI agents
brew "qwen-code"
brew "kimi-code"

# Block Goose (CLI)
# Was tap "block/goose" - that tap is gone (the clone 404s) and the CLI now
# ships in homebrew-core under a different name.
brew "block-goose-cli"

# Desktop apps
cask "claude"
cask "chatgpt"
