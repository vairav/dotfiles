# Brewfile.core - Essential system packages
# Usage: brew bundle --file=Brewfile.core

# Taps
# None. Everything here is in homebrew-core.
#
# Homebrew 6 requires explicit trust for third-party taps, and an untrusted or
# failed tap aborts the ENTIRE Brewfile - this file silently installed nothing
# on a fresh machine because of it. Prefer core formulae; if unavoidable,
# `brew trust` it in a setup script, never rely on the bundle to do it.
#   - homebrew/services : deprecated, `brew services` is built in
#   - buo/cask-upgrade  : superseded by native `brew upgrade --cask`
#   - yqrashawn/goku    : goku is in core now

# System libraries
brew "openssl"
brew "ncurses"

# Shells
brew "bash"
brew "bash-completion@2"
brew "zsh"
brew "zsh-lovers"

# Core utilities (GNU replacements)
brew "coreutils"
brew "gawk"
brew "wget"
brew "curl"

# Compression
brew "p7zip"
brew "xz"
brew "unar"                 # replaces unrar, which was removed from core

# Dotfile management (install.sh runs rcup - without this nothing symlinks)
brew "rcm"

# Essential CLI tools
brew "git"
brew "git-lfs"
brew "jq"
brew "yq"
brew "dasel"                # Query JSON/YAML/TOML/XML (multi-format)
brew "tree"
brew "watch"
brew "tldr"
brew "tealdeer"             # Rust tldr client (faster)

# Modern replacements
brew "bat"                  # cat replacement
brew "eza"                  # ls replacement (exa successor)
brew "fd"                   # find replacement
brew "ripgrep"              # grep replacement
brew "fzf"                  # fuzzy finder
brew "zoxide"               # cd replacement
brew "atuin"                # Shell history sync

# Monitoring
brew "htop"

# macOS utilities
brew "mas"                  # Mac App Store CLI
brew "m-cli"                # macOS CLI swiss army knife
brew "trash"                # Move to trash instead of rm

# Network utilities
brew "netcat"
brew "telnet"
brew "sshpass"              # SSH password automation

# Remote filesystems: see Brewfile.dev.workstation.
# macfuse is a kernel extension - on Apple Silicon it needs Reduced Security
# enabled from Recovery plus a reboot, which is not an acceptable default for
# a laptop that just wants to ssh into things.

# OCR
brew "tesseract"            # OCR engine

# Karabiner
brew "goku"                 # Karabiner config manager (uses EDN format)
