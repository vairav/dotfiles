# Brewfile.apps.personal.workstation - Heavy personal software (workstation only)
#
# Audio production and CAD. Multi-GB installs that want a big screen and a
# power cable - deliberately kept off laptops.
#
# Usage: brew bundle --file=Brewfile.apps.personal.workstation

cask_args appdir: "/Applications"

# Rogue Amoeba audio production suite (https://rogueamoeba.com/)
# SoundSource is NOT here - it is a light menu-bar utility, so it lives in
# Brewfile.apps.personal and follows you onto laptops.
cask "audio-hijack"             # Record any audio
cask "loopback"                 # Virtual audio routing
cask "farrago"                  # Soundboard for audio clips
cask "fission"                  # Fast audio editor
cask "piezo"                    # Simple audio recording

# 3D/CAD
cask "freecad"
