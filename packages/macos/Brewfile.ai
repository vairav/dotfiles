# Brewfile.ai - AI essentials every machine gets, work machines included
#
# Kept to tools a client is likely to approve: US-hosted model providers and
# an editor. Everything else (the other CLI agents and the desktop chat apps)
# lives in Brewfile.ai.personal, which every non-work machine also gets.
# Local-model tools (LM Studio, Ollama, Msty) are --stack localai.
#
# Claude Code is NOT here: it comes from the native installer
# (scripts/setup-claude-code.sh), which updates itself. The old claude-code
# cask put a second `claude` on PATH on any machine that also had the native
# install.
#
# Usage: brew bundle --file=Brewfile.ai

# CLI agents
brew "opencode"
brew "gemini-cli"
cask "codex"

# MCP
brew "mcp-toolbox"

# Editor
cask "zed"
