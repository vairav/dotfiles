# Brewfile.apps - GUI applications every Mac gets, work machines included
#
# Kept to what a client-owned laptop can carry. Everything else that used to be
# here (browsers beyond Firefox, chat, notes, menu bar utilities, VPN, App
# Store apps) moved to Brewfile.apps.personal, which every non-work machine
# also gets. The long tail lives in Brewfile.apps.workstation.
#
# Usage: brew bundle --file=Brewfile.apps

cask_args appdir: "/Applications"

# Browser
cask "firefox"

# Password manager. The 1Password SSH agent serves every SSH key, and setup's
# scripts/ssh-pubkeys.sh reads public keys through the op CLI.
cask "1password"
cask "1password-cli"

# System utilities
cask "alfred"
cask "rectangle"
