# Brewfile.apps.workstation - Full GUI application suite (workstation only)
# Usage: brew bundle --file=Brewfile.apps.workstation

cask_args appdir: "/Applications"

# Browsers
cask "google-chrome"
cask "firefox@developer-edition"    # renamed upstream
cask "comet"                    # Perplexity's AI browser

# Communication
cask "discord"
cask "legcord"                  # Discord client with custom themes
cask "rocket-chat"

# Notes & Knowledge
cask "logseq"
cask "notion"

# System Utilities
cask "adguard"
cask "antigravity"
cask "antinote"
cask "betterdisplay"
cask "bettertouchtool"
# cask "cheatsheet"             # Hold Cmd to see shortcuts. DISABLED: upstream
                                # DMG at mediaatelier.com is a hard 404 as of
                                # Aug 2026. Re-enable if the vendor returns.
cask "cleanshot"
cask "clop"
cask "hazel"
cask "homerow"
cask "keyboard-maestro"
cask "keymapp"                  # ZSA keyboard configurator
cask "loop"                     # Window manager with mouse gestures
cask "mouseless"                # Keyboard-driven mouse
cask "pixelsnap"
cask "popclip"
cask "qlcolorcode"              # Syntax highlighting for QuickLook
cask "hammerspoon"
cask "jordanbaird-ice"
cask "superkey"
cask "suspicious-package"       # Malware scanner for .pkg files

# Cloud & Storage
cask "box-drive"
cask "cryptomator"
cask "dropbox"
cask "forklift"                 # Finder file manager replacement
cask "google-drive"
cask "mountain-duck"
cask "homebrew/cask/onedrive"  # MUST be fully qualified: bare "onedrive" is
                                # also an old name of the onedrive-cli formula,
                                # and brew bundle resolves it to the formula -
                                # installing neither. See docs/packages.md.

# Media
# The editing suite (affinity*, krita, bloom, GarageBand, iMovie) moved to
# Brewfile.stack.creative - see --stack. These two stay: they transcode and
# download rather than edit, and a machine that skips creative still wants them.
cask "handbrake"                # Video transcoder
cask "open-video-downloader"

# Finance moved to Brewfile.stack.finance (--stack finance)

# Downloads
brew "yt-dlp"                   # youtube-dl is dead upstream; yt-dlp is the fork
brew "speedtest-cli"

# Mac App Store
mas "Grila", id: 6444335028
mas "TestFlight", id: 899247664
mas "Xcode", id: 497799835
