# Brewfile.dev - Development essentials (every dev machine, incl. laptop)
# Heavy tooling (docker, k8s, languages, debugging proxies) lives in
# Brewfile.dev.workstation.
# Usage: brew bundle --file=Brewfile.dev

# Taps
# None - lazygit is in homebrew-core. See the note in Brewfile.core about
# Homebrew 6 tap trust.

# Terminal emulators
# alacritty is NOT here: Homebrew disabled its cask on 2026-09-01 (fails the
# Gatekeeper check; upstream will not notarize). scripts/setup-alacritty.sh
# installs it from the GitHub release instead - install.sh runs it.
cask "kitty"
cask "ghostty"

# Terminal multiplexer
brew "tmux"
brew "reattach-to-user-namespace"
brew "mosh"
brew "sesh"                     # tmux session manager (fzf picker)

# Shell prompt
brew "starship"

# Editors
brew "neovim"
brew "neovim-remote"            # Open files in existing nvim instance

# Git tools
brew "git-extras"
brew "git-delta"
brew "difftastic"
brew "tig"
brew "pre-commit"
brew "gh"                       # GitHub CLI
brew "lazygit"

# File management
brew "ranger"
brew "ncdu"

# HTTP tools
brew "httpie"
brew "xh"

# Languages and runtimes (light)
brew "mise"                     # Runtime version manager (replaces asdf, nvm, pyenv)
brew "python"
brew "pipx"
brew "shellcheck"

# Code editors
cask "visual-studio-code"

# Misc dev tools
brew "prettyping"
brew "watchexec"
