# Brewfile.ai - AI essentials: all CLI agents + light desktop apps
# Local-model tools (LM Studio, Ollama, Msty) and extra AI editors live in
# Brewfile.ai.workstation - they need RAM/disk a 16GB laptop doesn't have.
# Usage: brew bundle --file=Brewfile.ai

# CLI agents
cask "claude-code"  # or: npm install -g @anthropic-ai/claude-code
brew "opencode"
brew "gemini-cli"
cask "codex"
brew "qwen-code"
brew "kimi-code"

# Block Goose (CLI)
# Was tap "block/goose" - that tap is gone (the clone 404s) and the CLI now
# ships in homebrew-core under a different name.
brew "block-goose-cli"

# MCP
brew "mcp-toolbox"

# Desktop apps (light)
cask "claude"
cask "chatgpt"
cask "zed"
