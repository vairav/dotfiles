# Brewfile.apps.workstation - Full GUI application suite (workstation only)
# Usage: brew bundle --file=Brewfile.apps.workstation

cask_args appdir: "/Applications"

# Browsers
cask "google-chrome"
cask "firefox-developer-edition"

# Communication
cask "discord"
cask "legcord"                  # Discord client with custom themes
cask "rocket-chat"

# Notes & Knowledge
cask "logseq"
cask "notion"

# System Utilities
cask "adguard"
cask "antigravity"
cask "antinote"
cask "betterdisplay"
cask "bettertouchtool"
cask "cheatsheet"               # Hold Cmd to see shortcuts
cask "cleanshot"
cask "clop"
cask "hazel"
cask "homerow"
cask "keyboard-maestro"
cask "keymapp"                  # ZSA keyboard configurator
cask "loop"                     # Window manager with mouse gestures
cask "mouseless"                # Keyboard-driven mouse
cask "pixelsnap"
cask "popclip"
cask "qlcolorcode"              # Syntax highlighting for QuickLook
cask "hammerspoon"
cask "jordanbaird-ice"
cask "superkey"
cask "suspicious-package"       # Malware scanner for .pkg files

# Cloud & Storage
cask "box-drive"
cask "cryptomator"
cask "dropbox"
cask "forklift"                 # Finder file manager replacement
cask "google-drive"
cask "mountain-duck"
cask "onedrive"

# Media & Creative
cask "affinity-designer"
cask "affinity-photo"
cask "affinity-publisher"
cask "bloom"
cask "comet"
cask "handbrake"                # Video transcoder
cask "krita"
cask "open-video-downloader"

# Finance
brew "beancount"
brew "fava"
cask "tradingview"

# Downloads
brew "youtube-dl"
brew "speedtest-cli"

# Mac App Store
mas "Canary Mail", id: 1236045954
mas "GarageBand", id: 682658836
mas "Grila", id: 6444335028
mas "iMovie", id: 408981434
mas "TestFlight", id: 899247664
mas "Xcode", id: 497799835
