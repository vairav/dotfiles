# Brewfile.apps.work - Work machine apps
# Usage: brew bundle --file=Brewfile.apps.work

cask_args appdir: "/Applications"

# Microsoft Office
cask "microsoft-excel"
cask "microsoft-word"
cask "microsoft-powerpoint"
cask "microsoft-outlook"
cask "microsoft-onenote"
cask "microsoft-teams"
# microsoft-defender is no longer in Homebrew - it is delivered by the org
# through Intune Company Portal, so let the MDM install it.

# Enterprise
cask "intune-company-portal"
