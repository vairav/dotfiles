# Brewfile.apps.work - Work machine apps, vendor-neutral
#
# Anything every work machine needs regardless of which stack the client runs.
# Vendor-specific software lives in Brewfile.apps.work.<vendor> and is selected
# with --vendor (repeatable), e.g.:
#
#   ./packages/install.sh laptop --work --vendor m365 --vendor aws
#
# Empty for now - everything that was here turned out to be Microsoft-specific.
#
# Usage: brew bundle --file=Brewfile.apps.work

cask_args appdir: "/Applications"
