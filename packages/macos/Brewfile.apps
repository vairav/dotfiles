# Brewfile.apps - Essential GUI applications (every Mac, incl. laptop)
# The long tail (extra browsers, cloud sync, creative suite, automation
# utilities) lives in Brewfile.apps.workstation.
# Usage: brew bundle --file=Brewfile.apps

cask_args appdir: "/Applications"

# Browsers
cask "firefox"
cask "zen"

# Communication
cask "slack"
cask "zoom"
cask "signal"
cask "whatsapp"

# Notes
cask "obsidian"

# System Utilities
cask "1password"
cask "1password-cli"
cask "alfred"
cask "aldente"                  # Battery charge limiter
cask "rectangle"
cask "stats"                    # Menu bar system monitor
cask "shottr"

# Security & VPN
cask "bitwarden"
cask "ente-auth"                # 2FA authenticator
cask "tailscale"

# Mac App Store
mas "Amphetamine", id: 937984704
mas "Dropover", id: 1355679052
mas "Keynote", id: 409183694
mas "Numbers", id: 409203825
mas "Pages", id: 409201541
mas "PastePal", id: 1503446680
