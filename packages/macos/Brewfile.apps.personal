# Brewfile.apps.personal - Personal-machine essentials (laptop + workstation)
#
# Ownership tiers the same way roles do: this file is the light set that any
# personal machine gets, and Brewfile.apps.personal.workstation holds the heavy
# creative/production software that only belongs on a desk.
#
# Usage: brew bundle --file=Brewfile.apps.personal

cask_args appdir: "/Applications"

# Audio
cask "soundsource"              # Per-app volume control (menu bar utility)
