# Brewfile.dev.workstation - Heavy development tools (workstation only)
# Usage: brew bundle --file=Brewfile.dev.workstation

# Taps
# None - lazydocker is in homebrew-core. See the note in Brewfile.core about
# Homebrew 6 tap trust.

# Shell prompt (alternative)
brew "oh-my-posh"

# Git tools (heavy/rare)
brew "git-flow"
brew "git-secrets"
brew "git-filter-repo"
brew "bfg"
brew "hub"

# Git GUI
cask "gitbutler"
cask "sourcetree"
cask "meld"                     # Diff tool

# Languages and runtimes (heavy)
brew "pipenv"
brew "go"
brew "ruby"
brew "rustup"
brew "lua"
brew "luajit"
brew "luarocks"
brew "lua-language-server"
brew "stylua"                   # Lua formatter
brew "ccls"                     # C/C++ language server

# Container tools
brew "lazydocker"
cask "podman-desktop"
cask "docker-desktop"           # renamed upstream from "docker"

# Kubernetes
brew "kubernetes-cli"
brew "helm"
brew "kustomize"
brew "kubectx"
brew "k9s"

# Network tools
brew "nmap"
cask "mitmproxy"                # HTTP/HTTPS proxy for debugging (now a cask)
cask "proxyman"                 # Native macOS HTTP debugging proxy
cask "wireshark-app"            # Network protocol analyzer (renamed upstream)

# Image/Media tools
brew "imagemagick"
brew "exiftool"
brew "ffmpeg"

# API tools
cask "postman"

# Database
brew "redis"
cask "dbeaver-community"

# Design
cask "figma"

# Documentation
cask "dash"                     # Offline documentation browser

# Diagram tools
brew "d2"                       # Modern diagram scripting language

# Remote filesystems (moved out of Brewfile.core)
# macfuse is a kernel extension: Apple Silicon needs Reduced Security enabled
# from Recovery plus a reboot before it will load. Workstation-only for that
# reason - laptops use plain ssh/mosh instead.
cask "macfuse"                  # FUSE support for macOS
# brew "sshfs"                  # Mount remote filesystems via SSH. DISABLED:
                                # no bottle since 2026, Tier 3 build-from-source
                                # against libfuse/macFUSE. Use mountain-duck
                                # (Brewfile.apps.workstation) instead.

# Misc dev tools
brew "autoconf"
brew "pandoc"
brew "rich-cli"                 # Rich text CLI output
