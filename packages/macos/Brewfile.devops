# Brewfile.devops - DevOps and Infrastructure tools (workstation only)
# Tailscale is NOT here - the cask in Brewfile.apps covers every machine
# (formula + cask together would run two daemons).
# Usage: brew bundle --file=Brewfile.devops

# AWS
brew "awscli"
cask "aws-vault"                # AWS credentials manager

# Terraform
brew "terraform"
brew "terraform-docs"           # Terraform documentation generator
brew "terragrunt"               # Terraform workflow tool
brew "tflint"                   # Terraform linter
# Terraform version switching is handled by mise (Brewfile.dev), which already
# replaces asdf/nvm/pyenv here. Dropped tfswitch + its warrensbox/tap: it is the
# only one of these tools not in homebrew-core, and under Homebrew 6 tap trust
# an untrusted tap aborts the entire Brewfile.

# Configuration Management
brew "ansible"
brew "packer"                   # Image builder for multiple platforms

# Secrets
brew "sops"                     # Secrets management - Encrypt / decrypt files
